datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(50)
  users User[]

  @@map("roles")
}

model Status {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(50)
  users    User[]
  products Product[]

  @@map("statuses")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  email      String     @db.VarChar(100)
  image      String?    @db.VarChar(255)
  ci         Int
  username   String     @unique @db.VarChar(30)
  password   String     @db.VarChar(70)
  role_id    Int
  status_id  Int        @default(1)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  role       Role       @relation(fields: [role_id], references: [id])
  status     Status     @relation(fields: [status_id], references: [id])
  sales      Sale[]
  purchases  Purchase[]

  @@map("users")
}

model Supplier {
  id             Int        @id @default(autoincrement())
  name           String     @db.VarChar(100)
  phone          String?    @db.VarChar(20)
  email          String?    @db.VarChar(100)
  address        String?    @db.VarChar(200)
  contact_person String?    @db.VarChar(100)
  products       Product[]
  purchases      Purchase[]

  @@map("suppliers")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.Text
  products    Product[]

  @@map("categories")
}

model StorageLocation {
  id          Int       @id @default(autoincrement())
  location    String    @db.VarChar(100)
  description String?   @db.Text
  products    Product[]

  @@map("storage_locations")
}

model Product {
  id                      Int              @id @default(autoincrement())
  image                   String?          @db.Text
  name                    String           @db.VarChar(150)
  product_code            String?          @unique @db.VarChar(50)
  description             String?          @db.Text
  purchase_price          Decimal          @db.Decimal(10, 2)
  selling_price           Decimal          @db.Decimal(10, 2)
  initial_stock           Int?             @default(0)
  current_stock           Int?             @default(0)
  supplier_id             Int?
  nutritional_information String?          @db.Text
  storage_location_id     Int?
  notes                   String?          @db.Text
  category_id             Int?
  status_id               Int?             @default(1)
  expiration_status       Int?             @default(0)
  create_by_user_id       Int?
  last_update_by_user_id  Int?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  supplier                Supplier?        @relation(fields: [supplier_id], references: [id])
  category                Category?        @relation(fields: [category_id], references: [id])
  storage_location        StorageLocation? @relation(fields: [storage_location_id], references: [id])
  status                  Status?          @relation(fields: [status_id], references: [id])
  lots                    Lot[]
  sale_details            SaleDetail[]
  purchase_details        PurchaseDetail[]

  @@map("products")
}

model Lot {
  id                     Int          @id @default(autoincrement())
  product_id             Int
  lot_number             String?      @db.VarChar(50)
  quantity               Float
  initial_quantity       Float
  expiration_date        DateTime
  create_by_user_id      Int?
  last_update_by_user_id Int?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  product                Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sale_details           SaleDetail[]

  @@map("lots")
}

model Sale {
  id              Int          @id @default(autoincrement())
  sale_code       String       @unique @db.VarChar(50)
  client_name     String       @default("Sin Nombre") @db.VarChar(100)
  client_nit      String       @default("0") @db.VarChar(30)
  total_amount    Decimal      @db.Decimal(10, 2)
  payment_method  String       @default("efectivo") @db.VarChar(30)
  cash_received   Decimal?     @db.Decimal(10, 2)
  change_returned Decimal?     @db.Decimal(10, 2)
  status          String       @default("completada") @db.VarChar(20)
  user_id         Int?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  user            User?        @relation(fields: [user_id], references: [id])
  details         SaleDetail[]

  @@map("sales")
}

model SaleDetail {
  id         Int      @id @default(autoincrement())
  sale_id    Int
  product_id Int
  lot_id     Int?
  quantity   Float
  unit_price Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)

  sale       Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id])
  lot        Lot?     @relation(fields: [lot_id], references: [id])

  @@map("sale_details")
}

model Purchase {
  id             Int              @id @default(autoincrement())
  invoice_number String?          @db.VarChar(100)
  supplier_id    Int
  total_amount   Decimal          @db.Decimal(10, 2)
  notes          String?          @db.Text
  user_id        Int?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  supplier       Supplier         @relation(fields: [supplier_id], references: [id])
  user           User?            @relation(fields: [user_id], references: [id])
  details        PurchaseDetail[]

  @@map("purchases")
}

model PurchaseDetail {
  id              Int       @id @default(autoincrement())
  purchase_id     Int
  product_id      Int
  lot_number      String?   @db.VarChar(50)
  expiration_date DateTime?
  quantity        Float
  purchase_price  Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2)

  purchase        Purchase  @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [product_id], references: [id])

  @@map("purchase_details")
}
